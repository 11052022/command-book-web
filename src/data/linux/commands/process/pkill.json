{
  "name": "pkill",
  "description": "按进程名发送信号",
  "synopsis": "pkill [选项] 进程名",
  "category": "进程管理",
  "danger_level": "high",
  "tags": [
    "进程",
    "终止",
    "信号",
    "名字",
    "关闭"
  ],
  "common_options": [
    {
      "name": "-9",
      "description": "强制终止"
    },
    {
      "name": "-u",
      "description": "只匹配指定用户的进程"
    }
  ],
  "related": [
    "pgrep",
    "kill",
    "killall",
    "pidof"
  ],
  "examples": [
    {
      "description": "终止所有 nginx 进程",
      "code": "sudo pkill nginx"
    },
    {
      "description": "强制终止指定用户的进程",
      "code": "pkill -9 -u username process"
    }
  ]
}
