{
  "name": "export",
  "description": "设置环境变量或使其对子进程可见",
  "synopsis": "export 变量=值",
  "category": "其他常用",
  "danger_level": "low",
  "tags": [
    "环境",
    "变量",
    "设置",
    "导出",
    "配置"
  ],
  "common_options": [
    {
      "name": "-p",
      "description": "列出所有导出的变量"
    }
  ],
  "related": [
    "env",
    "unset",
    "source"
  ],
  "examples": [
    {
      "description": "设置环境变量",
      "code": "export PATH=$PATH:/new/path"
    },
    {
      "description": "查看所有导出变量",
      "code": "export -p"
    },
    {
      "description": "设置编辑器",
      "code": "export EDITOR=vim"
    }
  ]
}
