{
  "name": "printf",
  "description": "格式化输出文本（比 echo 更精确）",
  "synopsis": "printf 格式 [参数...]",
  "category": "其他常用",
  "danger_level": "low",
  "tags": [
    "输出",
    "格式化",
    "打印",
    "文本"
  ],
  "related": [
    "echo",
    "awk",
    "seq"
  ],
  "common_options": [],
  "examples": [
    {
      "description": "格式化输出",
      "code": "printf 'Hello, %s\\n' \"World\""
    },
    {
      "description": "输出带前导零的数字",
      "code": "printf '%03d\\n' 7"
    },
    {
      "description": "格式化为表格",
      "code": "printf '%-10s %5d\\n' Name Age"
    }
  ]
}
