{
  "name": "mount",
  "description": "挂载文件系统",
  "synopsis": "mount [选项] 设备 挂载点",
  "category": "磁盘存储",
  "danger_level": "high",
  "tags": [
    "挂载",
    "文件系统",
    "磁盘",
    "分区",
    "USB",
    "ISO"
  ],
  "common_options": [
    {
      "name": "-t",
      "description": "指定文件系统类型"
    },
    {
      "name": "-o",
      "description": "指定挂载选项"
    }
  ],
  "related": [
    "umount",
    "findmnt",
    "lsblk",
    "fstab"
  ],
  "examples": [
    {
      "description": "挂载分区到指定目录",
      "code": "sudo mount /dev/sdb1 /mnt/data"
    },
    {
      "description": "挂载 ISO 镜像",
      "code": "sudo mount -o loop file.iso /mnt/iso"
    },
    {
      "description": "以只读方式挂载",
      "code": "sudo mount -o ro /dev/sdb1 /mnt/readonly"
    },
    {
      "description": "查看已挂载的文件系统",
      "code": "mount | column -t"
    }
  ]
}
