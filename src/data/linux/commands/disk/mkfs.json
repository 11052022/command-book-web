{
  "name": "mkfs",
  "description": "创建文件系统（格式化分区）",
  "synopsis": "mkfs.[类型] [选项] 设备",
  "category": "磁盘存储",
  "danger_level": "critical",
  "tags": [
    "格式化",
    "文件系统",
    "创建",
    "分区",
    "ext4",
    "磁盘"
  ],
  "related": [
    "fdisk",
    "parted",
    "fsck",
    "mount"
  ],
  "common_options": [
    {
      "name": "-t",
      "description": "指定文件系统类型"
    },
    {
      "name": "-L",
      "description": "设置卷标"
    }
  ],
  "examples": [
    {
      "description": "格式化为 ext4",
      "code": "sudo mkfs.ext4 /dev/sdb1"
    },
    {
      "description": "创建并设置卷标",
      "code": "sudo mkfs.ext4 -L mydata /dev/sdb1"
    }
  ]
}
