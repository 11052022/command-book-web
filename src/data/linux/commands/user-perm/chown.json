{
  "name": "chown",
  "description": "修改文件或目录的所属用户和组",
  "synopsis": "chown [选项] 用户[:组] 文件...",
  "category": "用户权限",
  "danger_level": "high",
  "tags": [
    "所有者",
    "组",
    "用户",
    "权限",
    "文件",
    "归属"
  ],
  "common_options": [
    {
      "name": "-R",
      "description": "递归修改目录及其内容"
    },
    {
      "name": "-v",
      "description": "显示修改过程"
    }
  ],
  "related": [
    "chmod",
    "chgrp",
    "useradd"
  ],
  "examples": [
    {
      "description": "修改文件所有者",
      "code": "sudo chown user1 file.txt"
    },
    {
      "description": "修改文件所有者和组",
      "code": "sudo chown user1:group1 file.txt"
    },
    {
      "description": "递归修改目录所有者和组",
      "code": "sudo chown -R www-data:www-data /var/www"
    }
  ]
}
