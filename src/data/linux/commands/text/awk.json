{
  "name": "awk",
  "description": "强大的文本处理语言，按列/字段处理数据",
  "synopsis": "awk [选项] '程序' [文件...]",
  "category": "文本处理",
  "danger_level": "medium",
  "tags": [
    "文本",
    "处理",
    "列",
    "字段",
    "分隔",
    "统计",
    "格式化",
    "报表"
  ],
  "common_options": [
    {
      "name": "-F",
      "description": "指定字段分隔符"
    },
    {
      "name": "-v",
      "description": "设置变量"
    }
  ],
  "related": [
    "sed",
    "grep",
    "cut",
    "sort"
  ],
  "examples": [
    {
      "description": "打印第 1 和第 3 列",
      "code": "awk '{print $1, $3}' file.txt"
    },
    {
      "description": "以逗号为分隔符处理",
      "code": "awk -F',' '{print $2}' data.csv"
    },
    {
      "description": "对第 2 列求和",
      "code": "awk '{sum += $2} END {print sum}' file.txt"
    },
    {
      "description": "按条件过滤行",
      "code": "awk '$3 > 100 {print $0}' file.txt"
    },
    {
      "description": "打印行号",
      "code": "awk '{print NR\": \"$0}' file.txt"
    }
  ]
}
