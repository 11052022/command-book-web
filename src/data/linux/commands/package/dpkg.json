{
  "name": "dpkg",
  "description": "Debian 低级包管理工具",
  "synopsis": "dpkg [选项] [.deb 包文件]",
  "category": "包管理",
  "danger_level": "high",
  "tags": [
    "包",
    "deb",
    "安装",
    "Debian",
    "Ubuntu"
  ],
  "common_options": [
    {
      "name": "-i",
      "description": "安装 deb 包"
    },
    {
      "name": "-r",
      "description": "移除软件包"
    },
    {
      "name": "-l",
      "description": "列出已安装的包"
    }
  ],
  "related": [
    "apt",
    "apt-get",
    "rpm"
  ],
  "examples": [
    {
      "description": "安装 deb 包",
      "code": "sudo dpkg -i package.deb"
    },
    {
      "description": "列出已安装的包",
      "code": "dpkg -l | grep nginx"
    },
    {
      "description": "移除软件包",
      "code": "sudo dpkg -r package_name"
    }
  ]
}
