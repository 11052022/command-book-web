    },
    {
      "name": "uninstall",
      "description": "卸载包"
    },
    {
      "name": "list",
      "description": "列出已安装的包"
    },
    {
      "name": "freeze",
      "description": "以 requirements.txt 格式输出"
    }
  ],
  "examples": [
    {
      "description": "安装 Python 包",
      "code": "pip install requests"
