{
  "name": "rpm",
  "description": "Red Hat 低级包管理工具",
  "synopsis": "rpm [选项] [.rpm 包文件]",
  "category": "包管理",
  "danger_level": "high",
  "tags": [
    "包",
    "rpm",
    "安装",
    "RedHat",
    "CentOS",
    "Fedora"
  ],
  "common_options": [
    {
      "name": "-i",
      "description": "安装 rpm 包"
    },
    {
      "name": "-e",
      "description": "卸载软件包"
    },
    {
      "name": "-q",
      "description": "查询已安装的包"
    }
  ],
  "related": [
    "yum",
    "dnf",
    "dpkg"
  ],
  "examples": [
    {
      "description": "安装 rpm 包",
      "code": "sudo rpm -i package.rpm"
    },
    {
      "description": "查询已安装的包",
      "code": "rpm -qa | grep nginx"
    },
    {
      "description": "卸载软件包",
      "code": "sudo rpm -e package_name"
    }
  ]
}
