    {
      "name": "find",
      "description": "搜索 snap 包"
    }
  ],
  "related": [
    "apt",
    "flatpak",
    "appimage"
  ],
  "examples": [
    {
      "description": "搜索软件包",
      "code": "snap find vscode"
    },
    {
      "description": "安装软件包",
      "code": "sudo snap install vscode"
    },
    {
      "description": "列出已安装的包",
      "code": "snap list"
    }
  ]
}
