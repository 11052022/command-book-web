{
  "name": "zip",
  "description": "创建 ZIP 压缩归档",
  "synopsis": "zip [选项] 压缩包名 文件...",
  "category": "文件操作",
  "danger_level": "low",
  "tags": [
    "压缩",
    "打包",
    "zip",
    "归档"
  ],
  "common_options": [
    {
      "name": "-r",
      "description": "递归压缩目录"
    },
    {
      "name": "-e",
      "description": "加密压缩"
    }
  ],
  "related": [
    "unzip",
    "tar",
    "gzip",
    "7z"
  ],
  "examples": [
    {
      "description": "压缩目录",
      "code": "zip -r archive.zip /path/to/dir"
    },
    {
      "description": "加密压缩文件",
      "code": "zip -e secret.zip file.txt"
    }
  ]
}
