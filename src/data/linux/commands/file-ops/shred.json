{
  "name": "shred",
  "description": "安全地覆盖并删除文件（防止恢复）",
  "synopsis": "shred [选项] 文件...",
  "category": "文件操作",
  "danger_level": "critical",
  "tags": [
    "删除",
    "安全",
    "粉碎",
    "覆盖",
    "清除",
    "隐私"
  ],
  "common_options": [
    {
      "name": "-n",
      "description": "覆盖次数（默认 3）"
    },
    {
      "name": "-u",
      "description": "覆盖后删除文件"
    },
    {
      "name": "-z",
      "description": "最后用零覆盖以隐藏痕迹"
    }
  ],
  "related": [
    "rm",
    "wipe",
    "dd"
  ],
  "examples": [
    {
      "description": "安全删除文件",
      "code": "shred -u secret.txt"
    },
    {
      "description": "多次覆盖后删除",
      "code": "shred -n 7 -uz sensitive_data.txt"
    }
  ]
}
