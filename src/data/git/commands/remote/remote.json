{
  "name": "git remote",
  "description": "管理远程仓库连接——添加、删除、重命名、查看远程仓库的 URL 映射",
  "synopsis": "git remote [options] <subcommand> [arguments]",
  "category": "remote",
  "danger_level": "medium",
  "tags": ["远程", "remote", "仓库", "URL", "管理", "连接"],
  "common_options": [
    { "name": "add <name> <url>", "description": "添加新的远程仓库" },
    { "name": "remove <name>", "description": "删除远程仓库" },
    { "name": "rename <old> <new>", "description": "重命名远程仓库" },
    { "name": "set-url <name> <url>", "description": "修改远程仓库的 URL" },
    { "name": "-v / --verbose", "description": "显示远程仓库的 URL（fetch + push）" },
    { "name": "show <name>", "description": "显示指定远程仓库的详细信息" },
    { "name": "prune <name>", "description": "清理本地已不存在的远程分支引用" }
  ],
  "related": ["git fetch", "git pull", "git push", "git clone"],
  "builder_options": {
    "groups": [
      {
        "label": "子命令",
        "type": "radio",
        "options": [
          { "flag": "add", "label": "添加远程仓库", "hint": "" },
          { "flag": "remove", "label": "删除远程仓库", "hint": "" },
          { "flag": "set-url", "label": "修改远程 URL", "hint": "" },
          { "flag": "rename", "label": "重命名远程仓库", "hint": "" },
          { "flag": "show", "label": "查看远程详情", "hint": "" }
        ]
      }
    ],
    "arguments": [
      { "key": "name", "label": "远程名称/URL", "placeholder": "origin 或 git@github.com:user/repo.git", "prefix": "" },
      { "key": "extra", "label": "额外参数（新名称/new URL）", "placeholder": "upstream 或新URL", "prefix": "" }
    ]
  },
  "examples": [
    { "description": "查看所有远程仓库", "code": "git remote -v" },
    { "description": "添加远程仓库", "code": "git remote add origin https://github.com/user/repo.git" },
    { "description": "修改远程 URL（从 HTTPS 切到 SSH）", "code": "git remote set-url origin git@github.com:user/repo.git" }
  ]
}
